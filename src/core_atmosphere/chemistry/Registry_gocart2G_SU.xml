     <var name="suSD_so2" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Sedimentation of SO2"/>

     <var name="suSD_so4" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Sedimentation of SO4"/>

     <var name="suSD_msa" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Sedimentation of MSA"/>

     <var name="suDP_dms" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Dry deposition of DMS"/>

     <var name="suDP_so2" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
