     <var name="MSAsmass" type="real" dimensions="nCells Time" units=kg m^{-3}"
               description="MSA surface mass concentration"/>

     <var name="MSAcmass" type="real" dimensions="nCells Time" units=kg m^{-3}"
               description="MSA column mass density"/>

     <var name="SO4mass" type="real" dimensions="nVertLevels nCells Time" units="kg kg^{-1}"
               description="SO4 aerosol mass minxg ratio"/>

     <var name="SO4sarea" type="real" dimensions="nVertLevels nCells Time" units="m2 m^{-3}"
               description="SO4 surface area density

     <var name="SO4snum" type="real" dimensions="nVertLevels nCells Time" units="m^{-3}"
               description="SO4 number density"

     <var name="pSO2" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional SO2 production from DMS oxidation"/>

     <var name="pMSA" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional MSA production from DMS oxidation"/>

     <var name="pSO4" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional SO4 production from all SO2 oxidation"/>

     <var name="pSO4g" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional SO4 production from gaseous SO2 oxidation"/>

     <var name="pSO4aq" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional SO4 production from aqueous SO2 oxidation"/>

     <var name="pSO4wt" type="real" dimensions="nVertLevels nCells Time" units="kg m^{-2} s^{-1}"
               description="3-dimensional SO4 production from aqueous SO2 oxidation (wet deposition)"/>

 </var_struct>

