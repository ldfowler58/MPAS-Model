 <var_struct name="SU2G_aops" time_levs="1">

     <var name="suEXTTAU" type="real" dimensions="nvAOPs nCells Time" units="unitlesu"
               description="Extinction AOT of sulfate aerosols"/>

     <var name="suSTEXTTAU" type="real" dimensions="nvAOPs nCells Time" units="unitlesu"
               description="Extinction AOT of sulfate aerosols in stratosphere"/>

     <var name="suSCATAU" type="real" dimensions="nvAOPs nCells Time" units="unitlesu"
               description="Scattering AOT of sulfate aerosols"/>

     <var name="suSTSCATAU" type="real" dimensions="nvAOPs nCells Time" units="unitlesu"
               description="Scattering AOT of sulfate aerosols in stratosphere"/>

     <var name="suEXTCOEF" type="real" dimensions="npAOPs nVertLevels nCells Time" units="m^{-1}"
               description="Monochromatic extinction coefficient of sulfate aerosols at 550 nm"/>

