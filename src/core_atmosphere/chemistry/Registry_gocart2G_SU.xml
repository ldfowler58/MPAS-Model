     <var name="suSV_so2" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Convective scavenging of SO2"/>

     <var name="suSV_so4" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
               description="Convective scavenging of SO4"/>

     <var name="suSV_msa" type="real" dimensions="nCells Time" units="kg m^{-2} s^{-1}"
